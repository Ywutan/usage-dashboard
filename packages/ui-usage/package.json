{
  "name": "@deepseek-ai/dsh-client-ui-usage",
  "description": "Per-workspace usage dashboard: session-log API calls, tokens, and estimated USD cost by local hour",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-usage"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-usage-report",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-store": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.3-alpha.1",
    "react": "*"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-usage-report": "workspace:^"
  }
}
