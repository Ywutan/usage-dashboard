{
  "name": "@deepseek-ai/dsh-usage-dashboard",
  "description": "Per-workspace usage dashboard for deepseek-harness: session-log API calls, tokens, and estimated USD cost, as a sidebar action and full-viewport report",
  "version": "0.1.3-alpha.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ywutan/usage-dashboard.git"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "setup": "node tools/link-harness.mjs && node tools/place-typert.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "build": "node tools/place-typert.mjs && tsc -b tsconfig.json && tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-store": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-util-values": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-workspace": ">=0.1.3-alpha.1",
    "react": "*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
