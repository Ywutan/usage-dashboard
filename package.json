{
  "name": "dsh-plugins",
  "description": "Out-of-tree deepseek-harness plugin packages: one folder per plugin, built and published without a harness checkout in the workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "link-harness": "node tools/link-harness.mjs",
    "postinstall": "node tools/link-harness.mjs && node tools/place-typert.mjs",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "build": "node tools/place-typert.mjs && pnpm run typecheck && pnpm -r run bundle",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
