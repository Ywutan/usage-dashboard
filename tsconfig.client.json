{
  // Browser face: the sidebar action and the dashboard panel.
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "include": [
    "src/client",
    "src/css-modules.d.ts",
    // Pure data types, shared by both faces: they carry no Context merge, so
    // each face compiles them into its own program.
    "src/types.ts"
  ]
}
