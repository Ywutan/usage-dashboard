{
  // Host face. Split from the browser face because both merge the cordis
  // Context under the same keys, so one program cannot see both.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.host.tsbuildinfo"
  },
  "files": [
    "src/index.ts",
    "src/types.ts",
    "src/usage.ts",
    "src/invariant.ts"
  ]
}
